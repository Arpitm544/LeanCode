# Copy to .env; never put credentials in frontend/VITE_ variables.
LEANCODE_TOKEN=replace-with-a-long-random-local-password
LEANCODE_DATA_DIR=.leancode
LEANCODE_REPOSITORIES={"demo":{"path":"benchmarks/tasks/boundary","confidential":true}}
# Bifrost base must include its OpenAI-compatible API prefix.
BIFROST_URL=http://127.0.0.1:8080/openai/v1
BIFROST_KEY=
# Ordered JSON routes. Prices are integer USD microdollars per million tokens.
# Configure real, verified prices before enabling a cloud route; missing prices block it.
LEANCODE_ROUTES=[]
# Example local route (Ollama's cloud features must be disabled):
# LEANCODE_ROUTES=[{"name":"local","model":"qwen2.5-coder:7b","url":"http://127.0.0.1:11434/v1","local":true,"input_rate":0,"output_rate":0}]
TAVILY_API_KEY=
# Your conservative upper-bound price in USD microdollars per basic Tavily search.
TAVILY_SEARCH_COST_MICRO=0
# Optional official documentation domains; no generic web search.
LEANCODE_DOC_DOMAINS=docs.python.org
LEANCODE_SANDBOX_IMAGE=leancode-sandbox:local
